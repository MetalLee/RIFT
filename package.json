{
  "name": "rift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent multi-agent development coordination inside DeepSeek Harness",
  "engines": { "node": ">=24 <25", "dsh": "0.2.1-rc.3" },
  "packageManager": "pnpm@11.4.0",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "rift": "./dist/cli/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:acceptance": "vitest run tests/acceptance",
    "rift": "tsx src/cli/main.ts",
    "poc": "tsx scripts/runtime-probe.ts",
    "poc:tools": "tsx scripts/lead-tools-probe.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-codex": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-claude-code": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
