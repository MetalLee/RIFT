{
  "name": "rift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent multi-agent development coordination inside DeepSeek Harness",
  "engines": {
    "node": ">=24 <25",
    "dsh": "0.2.1-rc.3"
  },
  "packageManager": "pnpm@11.4.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rift": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:ui",
    "build:ui": "vite build --config ui/vite.config.ts ui",
    "dev:ui": "vite --config ui/vite.config.ts ui",
    "typecheck": "tsc --noEmit && pnpm typecheck:ui",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "test:ui": "vitest run ui/src/state.test.ts ui/src/api.test.ts ui/src/chat-state.test.ts ui/src/task-order.test.ts ui/src/stream-state.test.tsx ui/src/workspace-stream.test.ts ui/src/chat-timeline.test.ts ui/src/skill-library.test.tsx",
    "test": "vitest run",
    "test:stream": "vitest run tests/core/safe-stream.test.ts tests/core/native-codex.test.ts tests/core/dsh-chat-injection.test.ts tests/acceptance/live-agent-stream.test.ts tests/acceptance/live-dsh-stream.test.ts tests/acceptance/collaboration-review.test.ts tests/acceptance/chat-orchestration-review.test.ts tests/acceptance/browser-service.test.ts tests/acceptance/management-security.test.ts tests/acceptance/conversation-titles.test.ts tests/core/connection-worktree-migration.test.ts tests/core/native-sessions.test.ts tests/core/chat-context.test.ts tests/core/chat-connection-recovery.test.ts tests/core/chat-repository-access.test.ts ui/src/stream-state.test.tsx ui/src/workspace-stream.test.ts ui/src/chat-timeline.test.ts ui/src/chat-state.test.ts ui/src/api.test.ts",
    "probe:stream": "tsx scripts/live-stream-probe.ts",
    "probe:stream:native": "tsx scripts/native-live-stream-probe.ts",
    "test:acceptance": "vitest run tests/acceptance",
    "rift": "tsx src/cli/main.ts",
    "poc": "tsx scripts/runtime-probe.ts",
    "poc:tools": "tsx scripts/lead-tools-probe.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-claude-code": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-codex": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.0.18"
  }
}
